{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vidhyatex-media",
  "account_id": "eb44426b1fd72351f6b204ddb5d9b586",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  // Served on vidhyatex-media.<subdomain>.workers.dev until a media custom domain exists.
  "workers_dev": true,
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "vidhyatex-cdn"
    }
  ],
  "secrets": {
    "required": ["MEDIA_PROXY_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
